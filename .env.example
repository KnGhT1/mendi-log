# Copia los nombres necesarios al entorno de ejecucion; no guardes secretos aqui.

# Obligatoria fuera de desarrollo local. Genera un valor aleatorio, por ejemplo:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
MENDI_SECRET_KEY=

# Define 1 cuando la aplicacion se sirva por HTTPS.
MENDI_REQUIRE_HTTPS=0

# Opcional. Si se omite, la aplicacion usa SQLite en data/mendi.db.
# MENDI_DATABASE_URL=sqlite:///ruta/absoluta/a/mendi.db